# =============================================================================
# Kwami v3 — environment
# Copy to `.env` and fill in. Everything under NUXT_PUBLIC_* reaches the browser.
# =============================================================================

# --- Site
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------------------
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Service-role key. Server only — it bypasses row level security.
NUXT_SUPABASE_SERVICE_KEY=sb_secret_...

# --- Solana -------------------------------------------------------------------
NUXT_PUBLIC_SOLANA_CLUSTER=devnet
NUXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NUXT_PUBLIC_KWAMI_PROGRAM_ID=DoQubWtmNa4WZTLWxe1iptCDrwf81M8LHDrZDP7pEBbL
NUXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# A private RPC with higher rate limits, used for server-side reads.
NUXT_SOLANA_RPC_URL=https://api.devnet.solana.com

# Platform treasury — receives the flat commission charged on every mint.
# Empty means no commission instruction is added at all.
NUXT_PUBLIC_PLATFORM_TREASURY=
# Flat SOL commission per Kwami minted and deployed.
NUXT_PUBLIC_MINT_COMMISSION_SOL=0.5

# Base58 secret key of the win-attestation oracle (Attested resolution mode).
NUXT_ORACLE_SECRET_KEY=

# 32-byte hex key that encrypts Kwami secrets at rest.
# Generate with: bun run scripts/gen-keys.ts
NUXT_SECRET_ENCRYPTION_KEY=

# --- MoonPay ------------------------------------------------------------------
NUXT_PUBLIC_MOONPAY_PUBLISHABLE_KEY=pk_test_...
NUXT_MOONPAY_SECRET_KEY=sk_test_...

# --- LiveKit (voice) ----------------------------------------------------------
NUXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
NUXT_LIVEKIT_API_KEY=
NUXT_LIVEKIT_API_SECRET=

# --- AI (program builder + Kwami persona) -------------------------------------
NUXT_ANTHROPIC_API_KEY=
NUXT_OPENAI_API_KEY=
