{
  "name": "kwami-x",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.18",
  "description": "Kwami v3 — Solana NFT companions with on-chain voice games, AI program builder and embeddable 3D avatars.",
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,json,md}\"",
    "anchor:build": "cd programs && anchor build",
    "anchor:test": "cd programs && anchor test",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > shared/types/database.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@pinia/nuxt": "^1.0.2",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.93.1",
    "@vueuse/core": "^13.9.0",
    "@vueuse/nuxt": "^13.9.0",
    "bs58": "^6.0.0",
    "livekit-client": "^2.15.10",
    "marked": "^18.0.11",
    "nuxt": "^4.5.2",
    "pinia": "^3.0.4",
    "three": "^0.183.0",
    "tweetnacl": "^1.0.3",
    "vue": "^3.5.30",
    "vue-router": "^4.5.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@types/three": "^0.183.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.2",
    "happy-dom": "^20.0.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.4"
  }
}
