{
  "name": "kwami-x",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.18",
  "description": "Kwami v3 — Solana NFT companions with on-chain voice games, AI program builder and embeddable 3D avatars.",
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,json,md,mjs,yml,yaml}\"",
    "anchor:build": "cd programs && anchor build",
    "anchor:test": "cd programs && anchor test",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > shared/types/database.ts",
    "format:check": "prettier --check \"**/*.{ts,vue,json,md,mjs,yml,yaml}\"",
    "test:ci-scripts": "node --test \"scripts/ci/*.test.mjs\"",
    "release:baseline": "node scripts/release/ensure-baseline-tag.mjs",
    "release:dry-run": "bunx semantic-release --dry-run --no-ci",
    "prepare": "husky",
    "rules:apply": "node scripts/ci/apply-branch-rules.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@pinia/nuxt": "^1.0.2",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.93.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "bs58": "^6.0.0",
    "livekit-client": "^2.15.10",
    "marked": "^18.0.11",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "three": "^0.185.1",
    "tweetnacl": "^1.0.3",
    "vue": "^3.5.30",
    "vue-router": "^4.5.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.6",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "^10.9.1",
    "happy-dom": "^20.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.8.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.4"
  },
  "lint-staged": {
    "*.{ts,vue,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.rs": [
      "rustfmt --edition 2021"
    ]
  }
}
